# .env.example
# Copy this file to .env.local and fill in your real values.
# NOTE: Do NOT commit .env.local — it is gitignored.

# Supabase — the @supabase/ssr client reads these variables.
# IMPORTANT: NEXT_PUBLIC_SUPABASE_ANON_KEY must be the legacy JWT anon key
# (starts with "eyJ...") from Supabase -> Project Settings -> API -> Legacy anon, service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NVIDIA (used by the AI chat endpoint)
NVIDIA_API_KEY=
